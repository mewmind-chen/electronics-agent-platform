{
  "schemaVersion": "1.0",
  "dataset": "company-public-shapes-sanitized",
  "description": "脱敏公司检索形态；不含客户、联系人、私有报价、库存或凭据。",
  "cases": [
    { "id": "company-v1-001", "bucket": "trade", "input": { "company": "华南样本电子贸易", "steps": ["gys", "shop", "intel"] }, "expected": { "companyType": "贸易", "minimumEvidenceSources": ["gys"], "confidence": "medium", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "公开供应商页倾向贸易商；开发前人工确认主体与货源。" },
    { "id": "company-v1-002", "bucket": "trade", "input": { "company": "港深样本元件商行", "steps": ["gys", "shop"] }, "expected": { "companyType": "贸易", "minimumEvidenceSources": ["gys", "shop"], "confidence": "medium", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "商行公开挂货只能说明公开展示，不能推断成交能力。" },
    { "id": "company-v1-003", "bucket": "trade", "input": { "company": "东部样本半导体贸易", "steps": ["gys", "intel"] }, "expected": { "companyType": "贸易", "minimumEvidenceSources": ["gys"], "confidence": "low", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "单源名称匹配时保持低置信度。" },
    { "id": "company-v1-004", "bucket": "trade", "input": { "company": "样本国际电子供应", "steps": ["gys", "shop"] }, "expected": { "companyType": "贸易", "minimumEvidenceSources": ["gys"], "confidence": "medium", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "跨境/国际字样不是授权或原厂证明。" },
