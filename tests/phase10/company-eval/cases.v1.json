    { "id": "company-v1-015", "bucket": "ambiguous-name", "input": { "company": "样本科技", "steps": ["gys", "intel"] }, "expected": { "companyType": "unknown", "minimumEvidenceSources": ["intel"], "confidence": "low", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "名称相似不等于同一法人主体。" },
    { "id": "company-v1-016", "bucket": "ambiguous-name", "input": { "company": "样本半导体", "steps": ["gys", "shop"] }, "expected": { "companyType": "unknown", "minimumEvidenceSources": ["gys"], "confidence": "low", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "商铺名、公司名和品牌名可能并不一致。" },
