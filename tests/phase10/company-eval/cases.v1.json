    { "id": "company-v1-018", "bucket": "empty-evidence", "input": { "company": "样本空页企业乙", "steps": ["gys", "intel"] }, "expected": { "companyType": "unknown", "minimumEvidenceSources": [], "confidence": "low", "unknownWithoutEvidence": true, "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "不得根据名称编造主营品牌或型号。" },
    { "id": "company-v1-019", "bucket": "source-conflict", "input": { "company": "样本冲突供应链", "steps": ["gys", "shop", "intel"] }, "expected": { "companyType": "unknown", "minimumEvidenceSources": ["gys", "intel"], "confidence": "low", "sourceConflict": true, "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "主体或经营形态冲突时不合并为确定画像。" },
    { "id": "company-v1-020", "bucket": "source-conflict", "input": { "company": "样本多源不一致", "steps": ["gys", "shop", "intel"] }, "expected": { "companyType": "unknown", "minimumEvidenceSources": ["gys", "shop", "intel"], "confidence": "low", "sourceConflict": true, "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "不同公开源的品牌/型号展示冲突，保留来源并交人工裁决。" },
    { "id": "company-v1-021", "bucket": "wrong-company", "input": { "company": "不存在的样本器件贸易公司", "steps": ["gys", "shop", "intel"] }, "expected": { "companyType": "unknown", "minimumEvidenceSources": [], "confidence": "low", "unknownWithoutEvidence": true, "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "错误公司名不可借相似结果补全主体。" },
    { "id": "company-v1-022", "bucket": "wrong-company", "input": { "company": "样本品牌原厂办事处", "steps": ["gys", "intel"] }, "expected": { "companyType": "unknown", "minimumEvidenceSources": [], "confidence": "low", "unknownWithoutEvidence": true, "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "品牌名加办事处不等于已验证的公司实体。" }
