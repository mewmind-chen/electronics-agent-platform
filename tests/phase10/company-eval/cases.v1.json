    { "id": "company-v1-011", "bucket": "factory", "input": { "company": "样本电源科技", "steps": ["gys", "intel"] }, "expected": { "companyType": "工厂", "minimumEvidenceSources": ["gys", "intel"], "confidence": "medium", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "科技公司可能是贸易或工厂，需人工归类。" },
