    { "id": "company-v1-008", "bucket": "agent", "input": { "company": "样本品牌渠道商", "steps": ["gys", "intel"] }, "expected": { "companyType": "代理", "minimumEvidenceSources": ["intel"], "confidence": "low", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "渠道商标签须人工确认品牌覆盖范围。" },
