    { "id": "company-v1-006", "bucket": "agent", "input": { "company": "样本授权代理服务", "steps": ["gys", "intel"] }, "expected": { "companyType": "代理", "minimumEvidenceSources": ["gys", "intel"], "confidence": "medium", "requireEvidenceForBrands": true, "requireEvidenceForModels": true, "requiresHumanReview": true }, "humanLabel": "代理身份需公开授权证据，名称自称不充分。" },
