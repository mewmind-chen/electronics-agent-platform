{
  "name": "@electronics/import-core",
  "version": "0.3.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@electronics/import-core",
      "version": "0.3.0",
      "dependencies": {
        "@electronics/contracts": "file:../contracts",
        "@electronics/domain": "file:../electronics-domain"
      },
      "optionalDependencies": {
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
      }
    },
    "../contracts": {
      "name": "@electronics/contracts",
      "version": "0.2.0"
    },
    "../electronics-domain": {
      "name": "@electronics/domain",
      "version": "0.3.0",
      "dependencies": {
        "@electronics/contracts": "file:../contracts"
      }
    },
    "node_modules/@electronics/contracts": {
      "resolved": "../contracts",
      "link": true
    },
    "node_modules/@electronics/domain": {
      "resolved": "../electronics-domain",
      "link": true
    },
    "node_modules/xlsx": {
      "version": "0.20.3",
      "resolved": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "integrity": "sha512-oLDq3jw7AcLqKWH2AhCpVTZl8mf6X2YReP+Neh0SJUzV/BdZYjth94tG5toiMB1PPrYtxOCfaoUCkvtuH+3AJA==",
      "license": "Apache-2.0",
      "optional": true,
      "bin": {
        "xlsx": "bin/xlsx.njs"
      },
      "engines": {
        "node": ">=0.8"
      }
    }
  }
}
