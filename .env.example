# Required by compose.yaml and container startup. Generate a long random value.
AGENT_API_TOKEN=

# Bind the host port locally by default. The container itself listens on 0.0.0.0.
AGENT_API_BIND_ADDRESS=127.0.0.1

# Optional runtime model credential. It is injected by the deployment host and
# is never copied into the image or committed to this repository.
DEEPSEEK_API_KEY=

# Durable task metadata retention and per-task deadline (milliseconds). The
# request body and Radar/Workbench business context are never stored here.
TASK_TTL_MS=604800000
TASK_DEADLINE_MS=120000
