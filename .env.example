# Required by compose.yaml and container startup. Generate a long random value.
AGENT_API_TOKEN=

# Bind the host port locally by default. The container itself listens on 0.0.0.0.
AGENT_API_BIND_ADDRESS=127.0.0.1

# Optional runtime model credential. It is injected by the deployment host and
# is never copied into the image or committed to this repository.
DEEPSEEK_API_KEY=
# Production import/part/company routes use the Harness opencode-go provider.
# Keep this in the deployment secret store; never put it in the image or git.
OPENCODE_GO_API_KEY=

# Public market-source credentials are injected into Platform only. Firecrawl
# and AnySearch power the default public research path; ICNet login and Mouser
# API access are optional connectors and report auth_required when absent.
FIRECRAWL_API_KEY=
ANYSEARCH_API_KEY=
ICNET_COOKIE=
MOUSER_API_KEY=

# Durable task metadata retention and per-task deadline (milliseconds). The
# request body and Radar/Workbench business context are never stored here.
TASK_TTL_MS=604800000
TASK_DEADLINE_MS=120000

# Synchronous HTTP work is independently bounded. Import payloads may include
# base64 images/documents, so the default body ceiling is 12 MiB.
AGENT_REQUEST_DEADLINE_MS=120000
AGENT_MAX_BODY_BYTES=12582912
AGENT_RATE_LIMIT_PER_MINUTE=120
AGENT_RATE_WINDOW_MS=60000

# Local execution capacity. Additional accepted tasks wait in the in-process
# queue; once both limits are full the API returns 503 + Retry-After.
TASK_MAX_CONCURRENT=4
TASK_MAX_QUEUED=20
TASK_STALE_MS=30000
SSE_MAX_CONNECTIONS=100
AGENT_SHUTDOWN_GRACE_MS=10000
